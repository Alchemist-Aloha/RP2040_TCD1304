.program tcd1304_master_clock
.side_set 1

; A 4 MHz instruction rate produces the nominal 2 MHz master clock.
.wrap_target
    nop side 0
    nop side 1
.wrap

.program tcd1304_gates
.side_set 1

; This state machine runs at 4 MHz (one instruction cycle = 250 ns).
; SET controls SH and side-set controls ICG. Each request consists of two FIFO
; words: a token, the extra-preflush loop count, and the number of
; electronic-shutter pulses required during readout.
;
; One preflush pulse followed by the transfer pulse gives a 10 us effective
; exposure. The frame-transfer timing is:
;   t2 = 500 ns, t3 = 1 us, t1 = 5 us.
.wrap_target
    pull block          side 1

    ; Load every control word before phase anchoring. No blocking FIFO
    ; operation is permitted after WAIT, so CPU timing cannot stretch the
    ; waveform. Y holds the preflush count; OSR retains the readout count.
    pull block          side 1
    mov y, osr          side 1
    pull block          side 1

    ; Anchor the complete sequence to the master-clock phase. The instruction
    ; after WAIT begins with MC high.
    wait 0 gpio 14      side 1

    ; Generate all but the final preflush pulse at a 10 us cadence. The final
    ; pulse below is kept separate so ADC startup remains close to D0.
preflush_loop:
    set pins, 1         side 1 [3]
    set pins, 0         side 1
    set x, 5            side 1
preflush_low:
    jmp x-- preflush_low side 1 [3]
    jmp y-- preflush_loop side 1 [9]

    ; Final preflush SH pulse: 1 us high.
    set pins, 1         side 1 [3]
    set pins, 0         side 1

    ; Trigger ADC startup during the final pulse's low interval. RX DREQ
    ; starts the ADC through DMA, without CPU latency in the sampling phase.
    mov isr, null       side 1
    push block          side 1
    set x, 6            side 1
preflush_delay:
    jmp x-- preflush_delay side 1 [3]
    nop                 side 1 [1]

    ; ICG falls at t = 9.5 us, 500 ns before frame-transfer SH.
    nop                 side 0 [1]
    set pins, 1         side 0 [3]
    set pins, 0         side 0

    ; Hold ICG low for exactly 5 us after SH falls. Since the sequence was
    ; phase-anchored above, ICG rises with the MC rising edge at t = 16 us
    ; (t4 = 0 ns on the programmed timing grid).
    set x, 3            side 0
icg_delay:
    jmp x-- icg_delay   side 0 [3]
    nop                 side 0 [1]
    nop                 side 1

    ; First shutter pulse after frame transfer occurs at t = 20 us.
    mov y, osr          side 1
    nop                 side 1 [13]

    ; 1 us SH high and 9 us low: exactly 10 us rising-edge to rising-edge.
shutter_loop:
    set pins, 1         side 1 [3]
    set pins, 0         side 1
    set x, 5            side 1
shutter_low:
    jmp x-- shutter_low side 1 [3]
    jmp y-- shutter_loop side 1 [9]
.wrap

% c-sdk {
static inline void tcd1304_master_clock_init(PIO pio, uint sm, uint offset,
                                              uint pin, float clkdiv) {
    pio_sm_config c = tcd1304_master_clock_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tcd1304_gates_init(PIO pio, uint sm, uint offset,
                                      uint sh_pin, uint icg_pin,
                                      float clkdiv) {
    pio_sm_config c = tcd1304_gates_program_get_default_config(offset);
    sm_config_set_set_pins(&c, sh_pin, 1);
    sm_config_set_sideset_pins(&c, icg_pin);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_gpio_init(pio, sh_pin);
    pio_gpio_init(pio, icg_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sh_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, icg_pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}
