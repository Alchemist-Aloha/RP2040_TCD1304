.program tcd1304_master_clock
.side_set 1

; A 4 MHz instruction rate produces the nominal 2 MHz master clock.
.wrap_target
    nop side 0
    nop side 1
.wrap

.program tcd1304_gates
.side_set 1

; This state machine runs at 2 MHz (one instruction cycle = 500 ns).
; SET controls SH and side-set controls ICG. Each request consists of two FIFO
; words: a token followed by the number of electronic-shutter pulses required
; during readout.
;
; One preflush pulse followed by the transfer pulse gives a 40 us effective
; exposure. The frame-transfer timing is:
;   t2 = 500 ns, t3 = 1 us, t1 = 5 us.
.wrap_target
    pull block          side 1

    ; Preflush SH pulse at t = 0 us: 1 us high, then 38.5 us low.
    set pins, 1         side 1 [1]
    set pins, 0         side 1
    set x, 17           side 1
preflush_delay:
    jmp x-- preflush_delay side 1 [3]
    nop                 side 1 [2]

    ; ICG falls 500 ns before the frame-transfer SH rising edge.
    nop                 side 0
    set pins, 1         side 0
    nop                 side 0
    set pins, 0         side 0

    ; Hold ICG low for 5 us after SH falls, then raise it on the common
    ; 500 ns timing grid shared with the master-clock state machine.
    set x, 3            side 0
icg_delay:
    jmp x-- icg_delay   side 0 [1]
    nop                 side 1

    ; First shutter pulse after frame transfer must occur at t = 80 us.
    pull block          side 1
    mov y, osr          side 1
    set x, 15           side 1
first_shutter_delay:
    jmp x-- first_shutter_delay side 1 [3]

    ; 1 us SH high and 39 us low: exactly 40 us rising-edge to rising-edge.
shutter_loop:
    set pins, 1         side 1 [1]
    set pins, 0         side 1
    set x, 17           side 1
shutter_low:
    jmp x-- shutter_low side 1 [3]
    jmp y-- shutter_loop side 1 [3]
.wrap

% c-sdk {
static inline void tcd1304_master_clock_init(PIO pio, uint sm, uint offset,
                                              uint pin, float clkdiv) {
    pio_sm_config c = tcd1304_master_clock_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void tcd1304_gates_init(PIO pio, uint sm, uint offset,
                                      uint sh_pin, uint icg_pin,
                                      float clkdiv) {
    pio_sm_config c = tcd1304_gates_program_get_default_config(offset);
    sm_config_set_set_pins(&c, sh_pin, 1);
    sm_config_set_sideset_pins(&c, icg_pin);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_gpio_init(pio, sh_pin);
    pio_gpio_init(pio, icg_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sh_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, icg_pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}
